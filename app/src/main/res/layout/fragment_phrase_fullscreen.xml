<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/drawer_layout_fullscreen"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:openDrawer="end">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/white"
        android:clipChildren="false"
        android:clipToPadding="false">

        <!-- Bouton Fermer (Désormais calé dans le coin haut gauche) -->
        <ImageButton
            android:id="@+id/btn_close_fullscreen"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_margin="12dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_menu_close_clear_cancel"
            android:scaleType="centerInside"
            android:elevation="10dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            android:contentDescription="@string/close" />

        <!-- Le RecyclerView central -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_phrase_fullscreen"
            android:layout_width="match_parent"
            android:layout_height="320dp"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:paddingHorizontal="120dp"
            android:orientation="horizontal"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            tools:listitem="@layout/item_phrase_picto" />

        <!-- SÉLECTEUR DE TAILLE MINIMALISTE (Calé en bas à gauche) -->
        <com.google.android.material.button.MaterialButtonToggleGroup
            android:id="@+id/toggle_phrase_size"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="12dp"
            app:singleSelection="true"
            app:selectionRequired="true"
            app:checkedButton="@+id/btn_size_m"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent">
            
            <com.google.android.material.button.MaterialButton 
                android:id="@+id/btn_size_s" 
                style="?attr/materialButtonOutlinedStyle" 
                android:layout_width="44dp" 
                android:layout_height="44dp" 
                app:icon="@android:drawable/presence_invisible" 
                app:iconGravity="textStart"
                app:iconPadding="0dp"
                app:iconSize="12dp"
                app:iconTint="#999999"
                android:padding="0dp"
                app:shapeAppearanceOverlay="@style/ShapeAppearanceOverlay.Material3.Button.Circle"
                app:strokeColor="#EEEEEE" />
                
            <com.google.android.material.button.MaterialButton 
                android:id="@+id/btn_size_m" 
                style="?attr/materialButtonOutlinedStyle" 
                android:layout_width="44dp" 
                android:layout_height="44dp" 
                app:icon="@android:drawable/presence_invisible" 
                app:iconGravity="textStart"
                app:iconPadding="0dp"
                app:iconSize="20dp"
                app:iconTint="#666666"
                android:padding="0dp"
                app:shapeAppearanceOverlay="@style/ShapeAppearanceOverlay.Material3.Button.Circle"
                app:strokeColor="#EEEEEE" />
                
            <com.google.android.material.button.MaterialButton 
                android:id="@+id/btn_size_l" 
                style="?attr/materialButtonOutlinedStyle" 
                android:layout_width="44dp" 
                android:layout_height="44dp" 
                app:icon="@android:drawable/presence_invisible" 
                app:iconGravity="textStart"
                app:iconPadding="0dp"
                app:iconSize="28dp"
                app:iconTint="#333333"
                android:padding="0dp"
                app:shapeAppearanceOverlay="@style/ShapeAppearanceOverlay.Material3.Button.Circle"
                app:strokeColor="#EEEEEE" />
                
        </com.google.android.material.button.MaterialButtonToggleGroup>

        <!-- Boutons d'action en bas à droite -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_margin="24dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <!-- BOUTON MODE HORLOGE -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_clock_mode_fullscreen"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:layout_marginEnd="16dp"
                app:cardCornerRadius="16dp"
                app:cardBackgroundColor="#F5F5F5"
                app:cardElevation="6dp">

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:padding="14dp"
                    android:src="@drawable/ic_timer"
                    app:tint="#757575" />
            </com.google.android.material.card.MaterialCardView>

            <!-- BOUTON LECTURE / STOP TIMER -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_play_stop_timer_fullscreen"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:layout_marginEnd="16dp"
                app:cardCornerRadius="16dp"
                app:cardBackgroundColor="#F5F5F5"
                app:cardElevation="6dp">
                <ImageView
                    android:id="@+id/iv_play_stop_timer"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:padding="14dp"
                    android:src="@drawable/ic_play"
                    app:tint="#757575" />
            </com.google.android.material.card.MaterialCardView>

            <!-- Bouton Lecture -->
            <com.google.android.material.floatingactionbutton.FloatingActionButton
                android:id="@+id/fab_speak_fullscreen"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:contentDescription="@string/read_phrase"
                android:src="@android:drawable/ic_btn_speak_now"
                app:backgroundTint="@color/primary_color"
                app:elevation="6dp"
                app:tint="@color/white" />

        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- PANEL CONFIGURATION TIMER (Drawer) -->
    <include
        android:id="@+id/include_timer_config_fullscreen"
        layout="@layout/layout_card_timer_config"
        android:layout_width="300dp"
        android:layout_height="match_parent"
        android:layout_gravity="end" />

</androidx.drawerlayout.widget.DrawerLayout>
