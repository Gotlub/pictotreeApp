<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#FFFFFF">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="8dp"
        android:clickable="true"
        android:focusable="true">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Configuration du temps"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="?attr/colorPrimary"
            android:layout_marginBottom="6dp" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="8dp"
            app:cardElevation="0dp"
            app:strokeWidth="1dp"
            app:strokeColor="#E0E0E0"
            android:layout_marginBottom="10dp"
            app:cardBackgroundColor="#F8F9FA">
            
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="8dp"
                android:gravity="center_vertical">
                
                <TextView
                    android:id="@+id/tv_selected_picto_name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Pictogramme : Aucun"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="#333333" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="6dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Mode"
                android:textSize="12sp"
                android:textStyle="bold" />

            <RadioGroup
                android:id="@+id/rg_time_mode"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                <RadioButton android:id="@+id/rb_mode_none" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Non" android:textSize="12sp" android:visibility="gone" />
                <RadioButton android:id="@+id/rb_mode_jalon" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Jalon" android:textSize="12sp" android:layout_marginEnd="8dp" />
                <RadioButton android:id="@+id/rb_mode_timer" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Timer" android:textSize="12sp" />
            </RadioGroup>

        </LinearLayout>
            
        <LinearLayout
            android:id="@+id/layout_duration_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="6dp">

            <TextView
                android:id="@+id/tv_label_duration"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Durée (min)"
                android:textSize="12sp"
                android:textStyle="bold" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_duration_minus"
                style="@style/Widget.Material3.Button.IconButton.Filled.Tonal"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:text="-"
                android:textSize="16sp"
                android:textStyle="bold"
                android:insetTop="0dp"
                android:insetBottom="0dp" />

            <EditText
                android:id="@+id/et_duration"
                android:layout_width="40dp"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:inputType="number"
                android:maxLength="2"
                android:textSize="15sp"
                android:textStyle="bold"
                android:text="1"
                android:selectAllOnFocus="true"
                android:background="@android:color/transparent"
                android:textColor="#212121"
                android:layout_marginHorizontal="2dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_duration_plus"
                style="@style/Widget.Material3.Button.IconButton.Filled.Tonal"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:text="+"
                android:textSize="16sp"
                android:textStyle="bold"
                android:insetTop="0dp"
                android:insetBottom="0dp" />

        </LinearLayout>

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/switch_play_sound"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="32dp"
            android:paddingVertical="2dp"
            android:text="Sonner à la fin"
            android:textSize="12sp"
            android:layout_marginBottom="2dp" />



        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/switch_auto_remove"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="32dp"
            android:paddingVertical="2dp"
            android:text="Supprimer auto."
            android:textSize="12sp"
            android:layout_marginBottom="2dp" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/switch_visual_pulse"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="32dp"
            android:paddingVertical="2dp"
            android:text="Pulsation visuelle"
            android:textSize="12sp"
            android:layout_marginBottom="6dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_apply_time_config"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:text="Appliquer"
            android:textSize="13sp"
            app:cornerRadius="10dp"
            android:insetTop="0dp"
            android:insetBottom="0dp" />
            
        <View
            android:layout_width="match_parent"
            android:layout_height="4dp" />

    </LinearLayout>
</ScrollView>
