<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#FFFFFF">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp"
        android:clickable="true"
        android:focusable="true">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Configuration du temps"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="?attr/colorPrimary"
            android:layout_marginBottom="12dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Mode"
            android:textSize="13sp"
            android:textStyle="bold" />
        <RadioGroup
            android:id="@+id/rg_time_mode"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="8dp">
            <RadioButton android:id="@+id/rb_mode_none" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Non" android:textSize="12sp" />
            <RadioButton android:id="@+id/rb_mode_timer" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Timer" android:textSize="12sp" />
            <RadioButton android:id="@+id/rb_mode_jalon" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Jalon" android:textSize="12sp" />
        </RadioGroup>

        <TextView
            android:id="@+id/tv_label_duration"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Durée (minutes)"
            android:textSize="13sp"
            android:textStyle="bold" />
        <com.google.android.material.slider.Slider
            android:id="@+id/slider_duration"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:valueFrom="1"
            android:valueTo="60"
            android:stepSize="1"
            android:layout_marginBottom="8dp" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/switch_play_sound"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Sonner à la fin"
            android:textSize="13sp"
            android:layout_marginBottom="4dp" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/switch_auto_remove"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Supprimer auto."
            android:textSize="13sp"
            android:layout_marginBottom="16dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_apply_time_config"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:text="Appliquer"
            app:cornerRadius="12dp" />
            
        <View
            android:layout_width="match_parent"
            android:layout_height="20dp" />

    </LinearLayout>
</ScrollView>
