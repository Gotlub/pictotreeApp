<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="300dp"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    android:elevation="16dp"
    android:orientation="vertical"
    android:padding="16dp"
    android:clickable="true"
    android:focusable="true">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Configuration du temps"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="?attr/colorPrimary"
        android:layout_marginBottom="24dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Mode"
        android:textStyle="bold" />
    <RadioGroup
        android:id="@+id/rg_time_mode"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginBottom="16dp">
        <RadioButton android:id="@+id/rb_mode_none" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Aucun" />
        <RadioButton android:id="@+id/rb_mode_timer" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Time Timer" />
        <RadioButton android:id="@+id/rb_mode_jalon" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Jalon (Bordure)" />
    </RadioGroup>

    <TextView
        android:id="@+id/tv_label_duration"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Durée (minutes)"
        android:textStyle="bold" />
    <com.google.android.material.slider.Slider
        android:id="@+id/slider_duration"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:valueFrom="1"
        android:valueTo="60"
        android:stepSize="1"
        android:layout_marginBottom="16dp" />

    <com.google.android.material.materialswitch.MaterialSwitch
        android:id="@+id/switch_play_sound"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Sonner à la fin"
        android:layout_marginBottom="8dp" />

    <com.google.android.material.materialswitch.MaterialSwitch
        android:id="@+id/switch_auto_remove"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Supprimer auto. à la fin"
        android:layout_marginBottom="24dp" />

    <View
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_apply_time_config"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Appliquer" />

</LinearLayout>
